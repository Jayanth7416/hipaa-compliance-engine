# Application
APP_NAME="HIPAA Compliance Engine"
DEBUG=false
ENVIRONMENT=development

# AWS & Key Management
AWS_REGION=us-east-1
KMS_KEY_ID=alias/hipaa-compliance-key
USE_AWS_KMS=false
AUDIT_S3_BUCKET=s3://hipaa-audit-logs-bucket/

# Database (SQLite out-of-the-box; use PostgreSQL in production)
DATABASE_URL=sqlite:///./hipaa_compliance.db
# DATABASE_URL=postgresql://user:password@localhost:5432/hipaa_compliance

# Redis
REDIS_URL=redis://localhost:6379/0

# Cryptography & Hashing (replace with strong secrets in production!)
ENCRYPTION_SECRET=change-this-master-secret-in-production
ENCRYPTION_SALT=change-this-kdf-salt-in-production
HASH_PEPPER=change-this-hmac-pepper-in-production

# Authentication & RBAC
JWT_SECRET_KEY=change-this-jwt-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENFORCE_AUTH=false
DEFAULT_API_KEY=hipaa-dev-api-key

# Audit & Compliance
AUDIT_LOG_RETENTION_DAYS=2555
MAX_UPLOAD_SIZE_BYTES=10485760
COMPLIANCE_CONFIG_PATH=config/compliance.yaml
